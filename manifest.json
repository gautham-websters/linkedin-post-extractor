{
  "manifest_version": 3,
  "name": "LinkedIn Search Post Extractor",
  "version": "2.2",
  "description": "User-triggered extraction of LinkedIn content search posts with auto-scroll, deduplication, reliable post permalinks, repost handling, and XLSX export.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_title": "LinkedIn Post Extractor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/content/*"],
      "js": ["page_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.linkedin.com/search/results/content/*"],
      "js": ["minixlsx.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
